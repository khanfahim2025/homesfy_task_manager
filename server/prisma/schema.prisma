generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole @default(member)
  team         Team     @default(tech)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  passwordHash String?  @map("password_hash")

  attachments            Attachment[]
  comments               Comment[]
  createdProjects        Project[]
  assignedTasks          Task[]              @relation("TaskAssignee")
  createdTasks           Task[]              @relation("TaskCreator")
  magicLinkTokens        magic_link_tokens[] @relation("TokenUser")
  magicLinkTokensCreated magic_link_tokens[] @relation("TokenCreatedBy")
  taskObservers          task_observers[]
  taskAssignees          task_assignees[]
  taskParticipants       task_participants[]
  taskScoreEvents        task_score_events[]

  @@map("users")
}

model Project {
  id            String   @id @default(cuid())
  name          String   @map("project_name")
  description   String?
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  primaryDomain String?  @map("primary_domain")
  projectCode   String?  @map("project_code")

  creator User   @relation(fields: [createdById], references: [id])
  tasks   Task[]

  @@index([primaryDomain])
  @@index([projectCode])
  @@map("projects")
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  projectId    String       @map("project_id")
  assigneeId   String?      @map("assigned_to")
  creatorId    String       @map("created_by")
  dueDate      DateTime?    @map("due_date")
  status       TaskStatus   @default(new)
  priority     TaskPriority @default(medium)
  category     TaskCategory @default(website_development) @map("task_category")
  team         Team         @default(tech)
  effortPoints Int          @default(5) @map("effort_points")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  completedAt  DateTime?    @map("completed_at")
  closedAt     DateTime?    @map("closed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  domainName     String? @map("domain_name")
  templateUrl    String? @map("template_url")
  docFileLink    String? @map("doc_file_link")
  locationIframe String? @map("location_iframe")
  gtmHead        String? @map("gtm_head")
  gtmBody        String? @map("gtm_body")
  contentText    String? @map("content_text")
  contentUrls    String? @map("content_urls")

  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator      User                @relation("TaskCreator", fields: [creatorId], references: [id])
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  comments     Comment[]
  observers    task_observers[]
  assignees    task_assignees[]
  participants task_participants[]
  scoreEvents  task_score_events[]

  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([team])
  @@index([creatorId])
  @@index([updatedAt])
  @@map("tasks")
}

model task_score_events {
  id         String   @id @default(cuid())
  task_id    String
  user_id    String
  points     Int
  reason     String
  created_at DateTime @default(now())

  tasks Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([user_id, created_at])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Attachment {
  id           String         @id @default(cuid())
  taskId       String         @map("task_id")
  fileUrl      String         @map("file_url")
  fileName     String?        @map("file_name")
  mimeType     String?        @map("mime_type")
  type         AttachmentType
  uploadedById String         @map("uploaded_by")
  createdAt    DateTime       @default(now()) @map("created_at")

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([fileUrl])
  @@map("attachments")
}

model magic_link_tokens {
  id            String           @id @default(cuid())
  token_hash    String           @unique
  email         String
  purpose       MagicLinkPurpose @default(set_password)
  expires_at    DateTime
  used_at       DateTime?
  user_id       String?
  created_by_id String?
  created_at    DateTime         @default(now())
  users         User?            @relation("TokenUser", fields: [user_id], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("TokenCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([user_id, purpose])
}

model task_observers {
  task_id  String
  user_id  String
  added_at DateTime @default(now())
  tasks    Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([user_id])
}

model task_assignees {
  task_id  String
  user_id  String
  added_at DateTime @default(now())
  tasks    Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([user_id])
}

model task_participants {
  task_id  String
  user_id  String
  added_at DateTime @default(now())
  tasks    Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([user_id])
}

enum MagicLinkPurpose {
  set_password
  login
}

enum TaskStatus {
  new
  assigned
  accepted
  in_progress
  done
  closed
}

enum TaskPriority {
  low
  medium
  high
}

enum AttachmentType {
  image
  document
  link
  video
  archive
}

enum TaskCategory {
  general
  website_development
  creative
  content_creation
}

enum Team {
  tech
  digital
}

enum UserRole {
  admin
  manager
  member
}
