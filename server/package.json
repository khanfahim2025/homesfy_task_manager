{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migration": "node scripts/new-migration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "user:create": "node scripts/create-user.mjs",
    "postinstall": "prisma generate",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "hono": "4.13.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "pg": "^8.13.1",
    "prisma": "7.10.0",
    "typescript": "^5.8.2",
    "wrangler": "4.149.0"
  }
}
